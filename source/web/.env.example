# URL API Go (dipakai klien SPA saat build/dev).
VITE_API_URL=http://localhost:8080
# Host utama aplikasi (koma). Halaman dari host lain = domain white label tenant → API lewat origin yang sama (reverse proxy).
# VITE_PRIMARY_HOSTS=arus.erayadigital.co.id
# Alamat yang ditampilkan untuk landing page tenant di host utama (butuh nginx web meneruskan /s/ ke API); kosong = alamat API.
# VITE_PUBLIC_PAGE_ORIGIN=https://arus.erayadigital.co.id

# Login/daftar Google: OAuth Client ID (tipe Web). Kosong = tombol Google tampil nonaktif. Harus sama dengan salah satu GOOGLE_CLIENT_IDS di backend.
# VITE_GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com

# Login/daftar SSO Eraya (OIDC). Harus sama dengan ERAYA_ISSUER / ERAYA_CLIENT_ID di backend; daftarkan callback <origin web>/auth/eraya/callback di Eraya. Kosong = tombol tidak tampil.
VITE_ERAYA_ISSUER=http://localhost:8090
VITE_ERAYA_CLIENT_ID=c_0ede940f5672083b3a69d812