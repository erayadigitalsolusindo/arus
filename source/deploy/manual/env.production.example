# Salin ke /srv/arus/api/.env di server, isi, lalu: chmod 600 .env && chown arus:arus .env
# Buat rahasia dengan: openssl rand -hex 24   (hex = aman dipakai di URL tanpa encoding)
APP_ENV=production
HTTP_ADDR=127.0.0.1:8080

# Role runtime aciraba_app (RLS berlaku). Password = POSTGRES_APP_PASSWORD di deploy/.env.
DATABASE_URL=postgres://aciraba_app:GANTI_APP_PASSWORD@127.0.0.1:5433/aciraba?sslmode=disable
# Pemilik skema, hanya untuk goose (dipakai update.sh, bukan API).
MIGRATE_DATABASE_URL=postgres://aciraba:GANTI_OWNER_PASSWORD@127.0.0.1:5433/aciraba?sslmode=disable
REDIS_URL=redis://:GANTI_REDIS_PASSWORD@127.0.0.1:6380/0

CORS_ORIGINS=https://arus.erayadigital.co.id
APP_BASE_URL=https://arus.erayadigital.co.id
# JANGAN diganti setelah live: semua PIN penyetuju dan rahasia 2FA jadi tak terbaca. Simpan salinan di password manager.
JWT_SECRET=GANTI_openssl_rand_base64_48
TRUST_PROXY=true

UPLOAD_DIR=/srv/arus/data/uploads

# Wajib di produksi (API menolak start tanpa SMTP_HOST).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACIRABA <noreply@erayadigital.co.id>

# Hanya untuk membuat Platform Admin pertama (min. 32 karakter). Hapus baris ini + restart setelah admin dibuat.
PLATFORM_SETUP_TOKEN=
