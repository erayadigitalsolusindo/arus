# /etc/systemd/system/arus-api.service  (jalur aaPanel: folder /www/wwwroot/arus, user www)
[Unit]
Description=ACIRABA API (Go)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=www
Group=www
# API membaca .env dari direktori kerja, jadi EnvironmentFile tidak dipakai.
WorkingDirectory=/www/wwwroot/arus/api
ExecStart=/www/wwwroot/arus/api/aciraba-api
Restart=always
RestartSec=3
LimitNOFILE=65536

# Pengerasan: proses hanya boleh menulis ke folder unggahan.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/www/wwwroot/arus/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
