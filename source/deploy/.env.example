# Salin ke deploy/.env lalu ubah. Jangan commit .env.
POSTGRES_USER=aciraba
POSTGRES_PASSWORD=ganti_password_dev
POSTGRES_DB=aciraba
# Password role runtime `aciraba_app` (RLS berlaku untuknya). Hanya dipakai saat volume data pertama kali dibuat.
POSTGRES_APP_PASSWORD=ganti_password_app_dev
# Port host sengaja bukan default agar tidak bentrok dengan Postgres/Redis lain di mesin dev.
POSTGRES_PORT=5433
REDIS_PASSWORD=ganti_password_redis_dev
REDIS_PORT=6380
