# Salin ke backend/.env untuk dev lokal (nilai harus cocok dengan deploy/.env).
APP_ENV=development
HTTP_ADDR=:8080
# Runtime: role aciraba_app (bukan pemilik tabel) agar Row Level Security selalu berlaku.
DATABASE_URL=postgres://aciraba_app:aciraba_app_dev_pw@127.0.0.1:5433/aciraba?sslmode=disable
# Migration (goose) dan alat admin: pemilik skema. Tidak dipakai API.
MIGRATE_DATABASE_URL=postgres://aciraba:aciraba_dev_pw@127.0.0.1:5433/aciraba?sslmode=disable
REDIS_URL=redis://:aciraba_redis_dev_pw@127.0.0.1:6380/0
# Origin SPA yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:5173
# Kunci penandatangan JWT (min. 32 byte): `openssl rand -base64 48`.
JWT_SECRET=ganti_dengan_string_acak_minimal_32_byte
# true hanya jika API di belakang reverse proxy tepercaya (membaca X-Forwarded-For untuk IP klien/rate limit).
TRUST_PROXY=false
# Alamat SPA untuk tautan di email (verifikasi, reset password). Wajib https:// di luar development.
APP_BASE_URL=http://localhost:5173
# Email transaksional. Kosongkan SMTP_HOST di dev: email hanya dicatat ke log (LogMailer). Wajib diisi di produksi.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ACIRABA <noreply@contoh.id>
